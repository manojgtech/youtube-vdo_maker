# Optional: point Remotion at a specific Chrome/Chromium binary.
# If unset, SceneForge auto-detects Chrome or Edge, then falls back to
# Remotion's managed Chrome Headless Shell.
# REMOTION_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional: the Claude Code CLI used by "Write with Claude" (default: `claude` on PATH).
# CLAUDE_CLI=C:\Users\you\.local\bin\claude.exe
